# Copy to .env and fill in. Never commit .env.
# Test-mode keys only. Live keys (rzp_live_*) are refused by the client.

RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# OpenRouter key for Jev (typed System One diagnosis).
# New OpenRouter accounts get a small free allowance — enough for this project.
# Leave empty to stay rules-only (or fall through to Gemini when DIAGNOSIS_PROVIDER=auto).
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.14
# Default OpenRouter System One endpoint. Swap to TypeSafe direct if preferred:
# JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
JEV_BASE_URL=https://openrouter.ai/api/v1/systemone

# Comparison LLM arm (GEMINI_API_KEY slot). Accepts:
#   - Google Gemini key + LLM_MODEL=gemini-...
#   - Groq key (gsk_...) + LLM_MODEL=openai/gpt-oss-20b (auto if model still says gemini-*)
GEMINI_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# Diagnosis cascade: auto | rules | keyword | jev | gemini
# auto = rules exact-match first, then Jev if keyed, else Gemini if keyed, else ambiguous.
DIAGNOSIS_PROVIDER=auto

# If true, no recovery action executes (checked by policy and the executor).
KILL_SWITCH=false

# Optional. Default is data/payrecover.db
# DB_PATH=data/payrecover.db

# Optional overrides (seconds / attempt count).
RAZORPAY_TIMEOUT_SECONDS=10
RAZORPAY_READ_RETRIES=3
JEV_TIMEOUT_SECONDS=30
JEV_READ_RETRIES=3
